# Any Postgres works. On Neon use the pooled URL (host contains `-pooler`) here;
# use the direct URL only for schema changes and dump/restore.
DATABASE_URL=postgres://user:pass@ep-example-pooler.eu-central-1.aws.neon.tech/intygy?sslmode=require
GITHUB_APP_ID=123456
# App permissions: Contents read, Metadata read, Pull requests write and Issues write (PR comments).
# Base64 of the .pem private key: `base64 -w0 intygy.private-key.pem`
GITHUB_APP_PRIVATE_KEY_B64=
GITHUB_WEBHOOK_SECRET=change-me
# Signs dashboard/report links (`openssl rand -hex 32`). Changing it revokes issued links.
LINK_SIGNING_SECRET=change-me
# Must equal the Action's `api-base` exactly: it is the audience of workflow tokens.
PUBLIC_BASE_URL=https://api.intygy.eu
PORT=3000
